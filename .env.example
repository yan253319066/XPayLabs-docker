# MySQL
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Database credentials (for Java services)
DB_USERNAME=root
DB_PASSWORD=your_db_password

# AES-256-CBC encryption key (32 characters, used by sui-node-service + xpay-sui)
ENCRYPTION_KEY=your_32_char_encryption_key_here

# JWT secret key (for xpay-merchant)
JWT_SECRET_KEY=your_jwt_secret_key_here

# HMAC-SHA256 secret for SkipSign
SKIP_SIGN_SECRET=your_64_char_hex_secret_here

# Redis (leave empty for no password; set a value to enable auth)
REDIS_PASSWORD=

# Public domain URLs (used by Java services)
XPAY_PAY_DOMAIN=https://pay.your-domain.com/checkout
XPAY_API_DOMAIN=https://api.your-domain.com

# Ethereum RPC URLs (comma-separated, override to change provider)
ETH_CHAINS_ETH_RPCURLS=https://0xrpc.io/eth,https://rpc.flashbots.net
ETH_CHAINS_ETH_SEPOLIA_RPCURLS=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY,https://rpc.ankr.com/eth_sepolia/YOUR_KEY
ETH_CHAINS_BSC_RPCURLS=https://bsc-dataseed.bnbchain.org,https://bsc-dataseed1.nariox.org
ETH_CHAINS_BSC_TEST_RPCURLS=https://data-seed-prebsc-1-s1.bnbchain.org:8545
ETH_CHAINS_POLYGON_RPCURLS=https://polygon-mainnet.rpcfast.com?api_key=YOUR_KEY
ETH_CHAINS_POLYGON_AMOY_RPCURLS=https://rpc-amoy.polygon.technology
ETH_CHAINS_AVAX_C_CHAIN_RPCURLS=https://api.avax.network/ext/bc/C/rpc
ETH_CHAINS_AVAX_FUJI_TEST_RPCURLS=https://api.avax-test.network/ext/bc/C/rpc

# TRON full/solidity nodes, private key & API key
TRON_CHAINS_TRON_FULLNODE=grpc.trongrid.io:50051
TRON_CHAINS_TRON_SOLIDITYNODE=grpc.trongrid.io:50052
TRON_CHAINS_TRON_HEXPRIVATEKEY=
TRON_CHAINS_TRON_APIKEY=YOUR_TRON_API_KEY
TRON_CHAINS_TRON_TEST_FULLNODE=grpc.shasta.trongrid.io:50051
TRON_CHAINS_TRON_TEST_SOLIDITYNODE=grpc.shasta.trongrid.io:50052
TRON_CHAINS_TRON_TEST_HEXPRIVATEKEY=
TRON_CHAINS_TRON_TEST_APIKEY=

# Gateway (single public entry point)
HOST_PORT_GATEWAY_HTTP=180
# HOST_PORT_GATEWAY_HTTPS=1443  # SSL: uncomment + put certs in ./certs/

# Host port mappings (left = host port, can change if port conflict)
HOST_PORT_MYSQL=13306
HOST_PORT_REDIS=16379
HOST_PORT_SUI_NODE=13001
HOST_PORT_XPAY_USER=18077
HOST_PORT_XPAY_MERCHANT=18078
HOST_PORT_XPAY_ETH=18076
HOST_PORT_XPAY_TRON=18075
HOST_PORT_XPAY_SUI=18074
