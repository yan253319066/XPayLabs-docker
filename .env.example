# MySQL
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Database credentials (for Java services)
DB_USERNAME=root
DB_PASSWORD=your_db_password

# AES-256-CBC encryption key (32 characters, used by sui-node-service + xpay-sui)
ENCRYPTION_KEY=your_32_char_encryption_key_here

# JWT secret key (for xpay-merchant)
JWT_SECRET_KEY=your_jwt_secret_key_here

# HMAC-SHA256 secret for SkipSign
SKIP_SIGN_SECRET=your_64_char_hex_secret_here

# Redis (leave empty for no password; set a value to enable auth)
REDIS_PASSWORD=

# Public domain URLs (used by Java services)
XPAY_PAY_DOMAIN=https://pay.your-domain.com/checkout
XPAY_API_DOMAIN=https://api.your-domain.com

# Ethereum RPC URLs (comma-separated, override to change provider)
ETH_NETWORKS=ETH,ETH_SEPOLIA,BSC,BSC_TEST,POLYGON,POLYGON_AMOY,AVAX_C_CHAIN,AVAX_FUJI_TEST
RPC_ETH=https://0xrpc.io/eth,https://rpc.flashbots.net
SCAN_ETH=15
RPC_ETH_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY,https://rpc.ankr.com/eth_sepolia/YOUR_KEY
SCAN_ETH_SEPOLIA=5
RPC_BSC=https://bsc-dataseed.bnbchain.org,https://bsc-dataseed1.nariox.org
SCAN_BSC=2
RPC_BSC_TEST=https://data-seed-prebsc-1-s1.bnbchain.org:8545
SCAN_BSC_TEST=2
RPC_POLYGON=https://polygon-mainnet.rpcfast.com?api_key=YOUR_KEY
SCAN_POLYGON=2
RPC_POLYGON_AMOY=https://rpc-amoy.polygon.technology
SCAN_POLYGON_AMOY=2
RPC_AVAX_C_CHAIN=https://api.avax.network/ext/bc/C/rpc
SCAN_AVAX_C_CHAIN=2
RPC_AVAX_FUJI_TEST=https://api.avax-test.network/ext/bc/C/rpc
SCAN_AVAX_FUJI_TEST=2

# TRON full/solidity nodes, private key & API key
TRON_NETWORKS=TRON,TRON_TEST
TRON_TX_FEE=30
TRON_ENERGY_APIKEY=YOUR_TRON_ENERGY_API_KEY
NODE_TRON=grpc.trongrid.io:50051
SOLIDITY_TRON=grpc.trongrid.io:50052
HEXKEY_TRON=
APIKEY_TRON=YOUR_TRON_API_KEY
NODE_TRON_TEST=grpc.shasta.trongrid.io:50051
SOLIDITY_TRON_TEST=grpc.shasta.trongrid.io:50052
HEXKEY_TRON_TEST=
APIKEY_TRON_TEST=

# Gateway (single public entry point)
HOST_PORT_GATEWAY_HTTP=180
# HOST_PORT_GATEWAY_HTTPS=1443  # SSL: uncomment + put certs in ./certs/

# Host port mappings (left = host port, can change if port conflict)
HOST_PORT_MYSQL=13306
HOST_PORT_REDIS=16379
HOST_PORT_SUI_NODE=13001
HOST_PORT_XPAY_USER=18077
HOST_PORT_XPAY_MERCHANT=18078
HOST_PORT_XPAY_ETH=18076
HOST_PORT_XPAY_TRON=18075
HOST_PORT_XPAY_SUI=18074
